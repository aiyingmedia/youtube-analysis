    },
    {
      "find": "尤其實",
      "replace": "尤其是"
    },
    {
      "find": "事實上來說",
      "replace": "事實上"
    },
    {
      "find": "所已",
      "replace": "所以"
    },
    {
      "find": "如果說說",
      "replace": "如果說"
    },
    {
      "find": "的時候候",
      "replace": "的時候"
    }
  ],
  "style": [
    {
      "find": "部份",
      "replace": "部分"
    },
    {
      "find": "其它",
      "replace": "其他"
    }
  ]
